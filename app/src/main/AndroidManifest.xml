<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Od Androidu 14 (targetSdk 34) musí každá foreground service mít deklarovaný typ -
         ChapterDownloadWorker běží jako foreground service (postup stahování v notifikaci),
         bez tohohle appka na startu stahování rovnou spadne (InvalidForegroundServiceTypeException). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Instalace stažené aktualizace přes systémový instalátor balíčků (sideload, appka
         není na Play Storu). Uživatel musí instalaci z tohoto zdroje ručně povolit. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".JiyuApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jiyu"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- WorkManager se jinak sam inicializuje pres ContentProvider driv,
             nez JiyuApp.workManagerConfiguration staci nastavit HiltWorkerFactory -
             vsichni @HiltWorker (download i update) by pak padali na
             NoSuchMethodException, protoze WorkManager pouzije svou vychozi
             reflection-based tovarnu misto Hiltem injektovane. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Sdílení souborů ven z appky (QR kód titulu). Bez téhle deklarace vyhodí
             FileProvider.getUriForFile IllegalArgumentException "Couldn't find meta-data
             for provider with authority com.haise.jiyu.provider" - a protože ji volající
             odchytává, tlačítko "Sdílet" pak nedělalo vůbec nic a mlčelo o tom.
             Authority musí přesně sedět s tou, na kterou se ptá kód
             (viz MangaQrScreen: "${context.packageName}.provider"). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:localeConfig="@xml/locales_config"
            android:theme="@style/Theme.Jiyu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link z notifikací: jiyu://manga?mangaId=xxx -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jiyu" android:host="manga" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.MalCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jiyu" android:host="mal-auth" />
            </intent-filter>
        </activity>

        <!-- WorkManager tuhle service deklaruje bez foregroundServiceType - na Androidu 14
             (targetSdk 34) je typ povinný, jinak setForeground() v ChapterDownloadWorker
             spadne s InvalidForegroundServiceTypeException. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Home screen widget -->
        <receiver
            android:name=".widget.JiyuWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jiyu_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CoverWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_cover_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cover_widget_info" />
        </receiver>

        <activity
            android:name=".widget.CoverWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Jiyu">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ShelfWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shelf_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shelf_widget_info" />
        </receiver>

        <activity
            android:name=".widget.ShelfWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Jiyu">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
