<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Žádný cleartext traffic (HTTP) není povolen - všechny zdroje jedou přes HTTPS.
         (Dřívější výjimka pro manga18fx.com zrušena - web přešel za Cloudflare s
         kompletním certifikátovým řetězcem a HTTP jen přesměrovává na HTTPS.) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Důvěřujeme pouze systémovým CA certifikátům, ne uživatelsky instalovaným -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
